// Part C STT-MRAM cell, exactly as given in the assignment.
-MemCellType: MRAM
-CellArea (F^2): 54.0
-CellAspectRatio: 2.0
-ResistanceOn (ohm): 3000
-ResistanceOff (ohm): 6000
-ReadMode: current
-ReadCurrent (uA): 40
-ReadPower (uW): 145
-ResetMode: current
-ResetCurrent (uA): 200
-ResetPulse (ns): 10
-SetMode: current
-SetCurrent (uA): 200
-SetPulse (ns): 10
-AccessType: CMOS
-AccessCMOSWidth (F): 6
